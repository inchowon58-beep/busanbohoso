{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/robots.txt",
      "has": [{ "type": "host", "value": "xn--l89at2a894aj7ccuad8ykls.daumzine.co.kr" }],
      "destination": "/busan-yugigyug/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [{ "type": "host", "value": "xn--l89at2a894aj7ccuad8ykls.daumzine.co.kr" }],
      "destination": "/busan-yugigyug/sitemap.xml"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "xn--l89at2a894aj7ccuad8ykls.daumzine.co.kr" }],
      "destination": "/busan-yugigyug/index.html"
    },
    {
      "source": "/index.html",
      "has": [{ "type": "host", "value": "xn--l89at2a894aj7ccuad8ykls.daumzine.co.kr" }],
      "destination": "/busan-yugigyug/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
